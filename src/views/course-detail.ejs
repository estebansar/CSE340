<%- include('partials/header') %>
<main>
    <div class="course-header">
        <h1><%= course.course_code %>: <%= course.name %></h1>
        <p class="course-meta"><%= course.department_code %> • <%= course.credit_hours %> credits</p>
        <p class="course-description"><%= course.description %></p>
    </div>
            <!--display query parameters to prove middleware works_unit2_part1_Create query parameter helper middleware-->
    <div class="query-params">
        <p><strong>Query Parameters:</strong></p>
         <pre><%= JSON.stringify(locals.queryParams, null, 2) %></pre> <!--queryParams -->
    </div>

    <div class="sections">
        <div class="sections-header">
            <h2>Available Sections</h2>
            <div class="sort-options">
                <span>Sort by: </span>
                <a href="/catalog/<%= course.slug %>?sort=time" class="<%= currentSort === 'time' ? 'active' : '' %>">Time</a>
                <a href="/catalog/<%= course.slug %>?sort=professor" class="<%= currentSort === 'professor' ? 'active' : '' %>">Instructor</a>
                <a href="/catalog/<%= course.slug %>?sort=room" class="<%= currentSort === 'room' ? 'active' : '' %>">Room</a>
            </div>
        </div>
        <div class="section-list">
            <% sections.forEach(section => { %>
                <div class="section-card">
                    <div class="section-time"><%= section.time %></div>
                    <div class="section-room">Room: <%= section.room %></div>
                    <div class="section-professor">Instructor: <%= section.professor %></div>
                </div>
            <% }); %>
        </div>
    </div>
    <div class="navigation">
        <p><a href="/catalog">&larr; Back to Course Catalog</a></p>
    </div>
</main>
<%- include('partials/footer') %>